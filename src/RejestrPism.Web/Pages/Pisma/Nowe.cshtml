@page
@model RejestrPism.Web.Pages.Pisma.NoweModel
@{ ViewData["Title"] = "Zarejestruj pismo"; }
<h1>Zarejestruj pismo</h1>
@if (!ViewData.ModelState.IsValid)
{
    <div class="error-summary" role="alert" tabindex="-1" id="bledy">
        <h2>Popraw błędy w formularzu</h2>
        <ul>@foreach (var e in ViewData.ModelState.Where(x => x.Value!.Errors.Count > 0)) { <li><a href="#@e.Key.Replace("Input.", "Input_")">@e.Value!.Errors[0].ErrorMessage</a></li> }</ul>
    </div>
}
<form method="post" novalidate>
    <fieldset class="field"><legend>Kierunek *</legend>
        <label class="inline"><input type="radio" asp-for="Input.Kierunek" value="Przychodzace" /> Przychodzące</label>
        <label class="inline"><input type="radio" asp-for="Input.Kierunek" value="Wychodzace" /> Wychodzące</label>
    </fieldset>
    <div class="field"><label asp-for="Input.Kontrahent">Nadawca / adresat *</label><input asp-for="Input.Kontrahent" autocomplete="off" aria-describedby="Input_Kontrahent-err" /><span id="Input_Kontrahent-err" class="err" asp-validation-for="Input.Kontrahent"></span></div>
    <div class="field"><label asp-for="Input.Przedmiot">Przedmiot *</label><input asp-for="Input.Przedmiot" aria-describedby="Input_Przedmiot-err" /><span id="Input_Przedmiot-err" class="err" asp-validation-for="Input.Przedmiot"></span></div>
    <div class="field"><label asp-for="Input.DataPisma">Data wpływu / wysłania *</label><input asp-for="Input.DataPisma" type="date" /></div>
    <div class="field"><label asp-for="Input.ZnakSprawy">Znak sprawy (JRWA)</label><input asp-for="Input.ZnakSprawy" aria-describedby="znak-hint" /><p id="znak-hint" class="hint">Np. OR.0001.1.2026</p></div>
    <div class="field"><label asp-for="Input.Komorka">Komórka / referat</label><input asp-for="Input.Komorka" /></div>
    <div class="field"><label asp-for="Input.Termin">Termin załatwienia</label><input asp-for="Input.Termin" type="date" /></div>
    <button class="btn" type="submit">Zarejestruj i nadaj numer</button>
</form>
