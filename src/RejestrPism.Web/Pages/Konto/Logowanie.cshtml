@page
@model RejestrPism.Web.Pages.Konto.LogowanieModel
@{ ViewData["Title"] = "Logowanie"; }
<h1>Logowanie</h1>
<p>Hasło do kont demonstracyjnych udostępnia Isvero Studio na prośbę. <a href="https://isverostudio.com/">Przejdź do strony Isvero Studio</a>, aby poprosić o dostęp. Nie używaj swojego prywatnego hasła.</p>
@if (Model.Blad is not null) { <div class="error-summary" role="alert"><p>@Model.Blad</p></div> }
<form method="post">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <div class="field"><label for="email">Adres e-mail</label><input id="email" name="email" type="email" autocomplete="username" required value="@Model.Email" /></div>
    <div class="field"><label for="haslo">Hasło</label><input id="haslo" name="haslo" type="password" autocomplete="current-password" required /></div>
    <button class="btn" type="submit">Zaloguj</button>
</form>
<p class="hint">Konta demo: kancelaria@demo.example, pracownik@demo.example. Po 5 nieudanych próbach konto jest blokowane na 5 minut.</p>
